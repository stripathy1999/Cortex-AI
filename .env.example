# Copy to .env and fill in your values

# Agent-S (required)
AGENT_PORT=8001
AGENT_HOST=127.0.0.1

# UI / Frontend
UI_PORT=8002
UI_HOST=127.0.0.1

# Backend (main.py)
SERVER_PORT=8003
SERVER_HOST=127.0.0.1

# Message bridge
# Mac: imessage_bridge.py (polls ~/Library/Messages/chat.db)
# Windows: windows_message_bridge.py (Discord, Slack, WhatsApp)
IMESSAGE_BRIDGE_PORT=8100
IMESSAGE_BRIDGE_HOST=127.0.0.1

# Windows message bridge - Discord, Slack, WhatsApp (comma-separated)
MESSAGE_SOURCES=discord,slack,whatsapp

# Allowed user - ONLY your messages are processed (required for each platform you use)
ALLOWED_DISCORD_USER_ID=your-discord-user-id
ALLOWED_SLACK_USER_ID=U01234567
ALLOWED_WHATSAPP_PHONE=+1234567890

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token

# Slack (Socket Mode - no ngrok needed)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# WhatsApp (Twilio - needs ngrok for webhook)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Call/voice service (works on both Mac and Windows)
CALL_SERVICE_PORT=5002
CALL_SERVICE_HOST=0.0.0.0

# Vision Mirror (optional)
VISION_SERVICE_PORT=5003
CURSOR_SERVICE_PORT=5004
CURSOR_SERVICE_URL=http://127.0.0.1:5004

# Stagehand browser automation (Chrome/Google/YouTube tasks)
STAGEHAND_SERVICE_URL=http://127.0.0.1:5005
# false = Chrome opens on YOUR PC; true = runs in Browserbase cloud (no visible browser)
STAGEHAND_USE_BROWSERBASE=false
# Seconds to keep Chrome open after task (0=close immediately; API response is delayed)
STAGEHAND_KEEP_OPEN_SECONDS=120
# Stagehand requires MODEL_API_KEY (or OPENAI_API_KEY as fallback) for openai/* models
MODEL_API_KEY=sk-your-openai-key
# OPENAI_API_KEY=sk-your-openai-key
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Contact links (for /api/contact_links - share with your phone)
CONTACT_WHATSAPP_NUMBER=+14155238886
# CONTACT_DISCORD_INVITE=https://discord.gg/your-invite

# API keys (required for Agent-S)
ANTHROPIC_API_KEY=sk-ant-your-key
# OPENAI_API_KEY=sk-your-openai-key
# GROK_API_KEY=xai-your-grok-key

# TTS/STT (optional - for voice)
# FISH_API_KEY=your-fish-audio-key

# Video call (Zoom API - for "video call me" to create meetings)
# Create a Server-to-Server OAuth app at https://marketplace.zoom.us/
# ZOOM_ACCOUNT_ID=your-account-id
# ZOOM_CLIENT_ID=your-client-id
# ZOOM_CLIENT_SECRET=your-client-secret
